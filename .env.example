# ==============================================================================
# EventPulse - Campus Event & Governance Platform Environment Configuration
# ==============================================================================

# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Demo Mode Toggle
# Set to 'true' ONLY for local demonstrations. Keep 'false' for production builds.
VITE_DEMO_MODE=false

# Restrict Student Registration by College Email Domain
# Example: sanjivani.edu.in or college.edu
# Leave empty to allow any email domain.
VITE_ALLOWED_EMAIL_DOMAIN=
